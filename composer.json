{
    "name": "eliksir/mailmojo-php-sdk",
    "version": "0.8.0",
    "description": "v1 of the Mailmojo API",
    "keywords": [
        "openapitools",
        "openapi-generator",
        "openapi",
        "php",
        "sdk",
        "rest",
        "api"
    ],
    "homepage": "https://mailmojo.dev",
    "license": "proprietary",
    "authors": [
        {
            "name": "Mailmojo",
            "homepage": "https://www.mailmojo.no"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "MailMojo\\": "MailMojo/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MailMojo\\Test\\": "test/"
        }
    }
}
